<Project>

    <!-- Global Properties -->
    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <!-- Package Metadata -->
    <PropertyGroup>
        <Authors>Karlssberg</Authors>
        <Company>Kunniga Solutions Ltd</Company>
        <Product>Motiv.FluentFactory</Product>
        <Copyright>Copyright © Daniel Karlsson 2025</Copyright>
        <PackageProjectUrl>https://github.com/motiv-solutions/Motiv.FluentFactory.Generator</PackageProjectUrl>
        <RepositoryUrl>https://github.com/motiv-solutions/Motiv.FluentFactory.Generator</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- Version Management -->
    <PropertyGroup>
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <PackageVersion>1.0.0</PackageVersion>
    </PropertyGroup>

</Project>